# Application
APP_NAME=Evoke
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Database — PostgreSQL (default)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=evoke
DB_USERNAME=evoke
DB_PASSWORD=evoke_secret

