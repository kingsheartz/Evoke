# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=evoke
# DB_USERNAME=evoke
# DB_PASSWORD=evoke_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Laravel
BACKEND_APP_KEY=
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

# Payments
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Notifications
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
