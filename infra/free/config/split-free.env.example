# Split free-tier reference — Vercel + Render + Neon
# Set these in each platform's dashboard (never commit real secrets).

# ── Vercel (frontend/) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://evoke-api.onrender.com/api/v1
NEXT_PUBLIC_APP_NAME=Evoke

# ── Render (backend web service) ───────────────────────────────────────────────
APP_NAME=Evoke
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
APP_URL=https://evoke-api.onrender.com
APP_TIMEZONE=Asia/Kolkata

FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

RUN_MIGRATIONS=true
# First deploy only — Render free has no Shell; set false after seed succeeds
RUN_SEED=true
SEED_DEMO=true

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

DB_CONNECTION=pgsql
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=from-neon-dashboard

# Optional — add when testing those features
# RESEND_API_KEY=
# RAZORPAY_KEY=
# RAZORPAY_SECRET=

# Firebase push (Render)
# FIREBASE_PROJECT_ID=evoke-group
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Firebase push (Vercel — public)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Cloudflare R2 media (Render — same as S3 driver)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_URL=
# NEXT_PUBLIC_MEDIA_BASE_URL=   # Vercel
